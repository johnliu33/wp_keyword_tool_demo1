# ============================================
# WP Keyword AI Tool - 環境變數範例
# ============================================
# 複製此檔案為 .env.local 並填入實際的值
# 指令：cp .env.example .env.local
# ============================================

# ============================================
# Supabase 設定
# ============================================
# 從 Supabase Dashboard > Project Settings > API 取得

# Supabase 專案 URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key（公開金鑰，可在前端使用）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key（私密金鑰，僅在後端使用）
# ⚠️ 重要：此金鑰具有完整資料庫權限，絕對不可洩漏或提交到 Git
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# 資料庫連線字串（Prisma 使用）
# ============================================
# 從 Supabase Dashboard > Project Settings > Database 取得

# Connection Pooling（用於應用程式連線）
# 格式：postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.xxxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection（用於 migrations）
# 格式：postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.xxxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ============================================
# OpenAI API 設定
# ============================================
# 從 https://platform.openai.com/api-keys 取得

# OpenAI API Key
OPENAI_API_KEY=sk-proj-...

# OpenAI 組織 ID（可選）
# OPENAI_ORG_ID=org-...

# ============================================
# 加密設定
# ============================================

# WordPress 密碼加密金鑰（必須是 32 字元）
# 產生方式：openssl rand -hex 16
# 或使用線上工具：https://randomkeygen.com/
ENCRYPTION_KEY=your-32-character-encryption-key-here

# ============================================
# Vercel Cron Jobs（部署到 Vercel 時使用）
# ============================================

# Cron Job 驗證金鑰（用於保護 Cron 端點）
# 產生方式：openssl rand -base64 32
CRON_SECRET=your-random-cron-secret-string

# ============================================
# Next.js 設定（可選）
# ============================================

# 應用程式 URL（正式環境需設定）
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Node 環境
# NODE_ENV=development

# ============================================
# 其他設定（未來功能）
# ============================================

# Google OAuth（V2 功能）
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sentry 錯誤追蹤（V2 功能）
# SENTRY_DSN=https://...

# Upstash Redis（Rate Limiting，V2 功能）
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# DataForSEO API（搜尋量查詢，V3 功能）
# DATAFORSEO_LOGIN=your-login
# DATAFORSEO_PASSWORD=your-password

# Unsplash API（圖片配圖，V3 功能）
# UNSPLASH_ACCESS_KEY=your-access-key
